# Public or private HTTPS base URL of the checkpoint-backed inference service.
# The web routes append /v1/analyze or /v1/analyze-frames and do not add
# application storage. Video sampling happens in the browser; raw video bytes
# are never forwarded to this URL.
SYNTHFLAG_INFERENCE_URL=http://127.0.0.1:8000

# Optional direct browser endpoint. This avoids app-server body limits for
# multipart image/frame requests; the service must allow the site origin via CORS.
NEXT_PUBLIC_SYNTHFLAG_INFERENCE_URL=http://127.0.0.1:8000
